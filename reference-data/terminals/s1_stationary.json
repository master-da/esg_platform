{
  "key": "s1_stationary",
  "module": "ghg",
  "scope": 1,
  "category_no": "1.2",
  "name": "Stationary combustion",
  "description": "Fuel burned on site in fixed equipment: boilers, generators, furnaces, ovens, dryers and stenters.",
  "excludes": "Fuel for vehicles goes in Mobile combustion. Purchased electricity, heat or steam go in Scope 2. Distance inputs are rejected here.",
  "instructions": "One row per facility, fuel and period, from fuel invoices, gas bills (e.g. Titas Gas) or generator logs.",
  "taxonomy_root": "s1.stationary",
  "accepts_bills": false,
  "enabled": true,
  "disabled_reason": null,
  "template_version": "0.1-provisional",
  "sort": 12,
  "config": {
    "activity_type": "fuel_combustion_stationary",
    "columns": [
      {
        "key": "facility",
        "header": "Facility",
        "type": "facility",
        "required": true
      },
      {
        "key": "period_start",
        "header": "Period start",
        "type": "date",
        "required": true
      },
      {
        "key": "period_end",
        "header": "Period end",
        "type": "date",
        "required": true
      },
      {
        "key": "supplier_name",
        "header": "Fuel supplier",
        "type": "text",
        "required": false
      },
      {
        "key": "equipment_type",
        "header": "Equipment",
        "type": "enum",
        "required": true,
        "options": [
          "Boiler",
          "Generator",
          "Furnace / oven",
          "Dryer / stenter",
          "Other equipment"
        ]
      },
      {
        "key": "fuel_type",
        "header": "Fuel type",
        "type": "enum",
        "required": true,
        "options": [
          "Natural gas",
          "LPG",
          "CNG",
          "Petrol / Octane",
          "Diesel",
          "Furnace oil",
          "Kerosene",
          "Gas oil",
          "Coal"
        ]
      },
      {
        "key": "quantity",
        "header": "Fuel quantity",
        "type": "decimal",
        "required": true,
        "min": 0,
        "role": "quantity"
      },
      {
        "key": "unit",
        "header": "Unit",
        "type": "unit",
        "required": true,
        "role": "unit",
        "options": [
          "m3",
          "L",
          "kg",
          "t",
          "kWh",
          "MMBtu",
          "gal_us"
        ]
      },
      {
        "key": "data_basis",
        "header": "Data basis",
        "type": "enum",
        "required": true,
        "role": "data_basis",
        "options": [
          "Metered / invoice",
          "Supplier or third-party data",
          "Estimate"
        ]
      },
      {
        "key": "notes",
        "header": "Notes",
        "type": "text",
        "required": false
      }
    ],
    "categorization_keys": [
      "fuel_type"
    ],
    "quality_grades": {
      "Metered / invoice": "A",
      "Supplier or third-party data": "B",
      "Estimate": "C"
    },
    "canonical_units": {
      "volume": "L",
      "mass": "kg",
      "energy": "kWh"
    },
    "rules": [
      {
        "type": "unit_dimension_in",
        "dimensions": [
          "volume",
          "mass",
          "energy"
        ],
        "problem": "Distance or other non-fuel quantity entered for a fuel category",
        "fix": "Enter the fuel quantity (volume, mass or energy). Distance-based travel belongs in Scope 3."
      },
      {
        "type": "period_order"
      },
      {
        "type": "period_within_project"
      }
    ]
  }
}
