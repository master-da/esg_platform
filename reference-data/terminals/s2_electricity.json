{
  "key": "s2_electricity",
  "module": "ghg",
  "scope": 2,
  "category_no": "2.1",
  "name": "Purchased electricity",
  "description": "Electricity bought from the national grid or a utility (DESCO, DPDC, BREB/PBS, NESCO, WZPDCL …) and consumed at your facilities.",
  "excludes": "Electricity generated on site from your own diesel or gas generators is Scope 1 stationary combustion (enter the fuel). On-site solar generation is entered in the Energy module.",
  "instructions": "One row per meter (or facility) and billing period, with the kWh consumed from the bill. You can also upload a bill PDF or photo: the system proposes the values and you confirm them.",
  "taxonomy_root": "s2.electricity",
  "accepts_bills": true,
  "enabled": true,
  "template_version": "0.1-provisional",
  "sort": 21,
  "config": {
    "activity_type": "electricity_purchased",
    "columns": [
      {"key": "facility", "header": "Facility", "type": "facility", "required": true},
      {"key": "period_start", "header": "Billing period start", "type": "date", "required": true},
      {"key": "period_end", "header": "Billing period end", "type": "date", "required": true},
      {"key": "supplier_name", "header": "Utility / supplier", "type": "text", "required": true},
      {"key": "meter_id", "header": "Meter / account no.", "type": "text", "required": false},
      {"key": "electricity_type", "header": "Electricity type", "type": "enum", "required": true,
       "options": ["Grid electricity"]},
      {"key": "quantity", "header": "Electricity consumed", "type": "decimal", "required": true, "min": 0, "role": "quantity"},
      {"key": "unit", "header": "Unit", "type": "unit", "required": true, "role": "unit", "options": ["kWh", "MWh"]},
      {"key": "amount_billed", "header": "Amount billed (BDT)", "type": "decimal", "required": false, "min": 0},
      {"key": "data_basis", "header": "Data basis", "type": "enum", "required": true, "role": "data_basis",
       "options": ["Utility bill / meter reading", "Landlord or supplier statement", "Estimate"]},
      {"key": "notes", "header": "Notes", "type": "text", "required": false}
    ],
    "categorization_keys": ["electricity_type"],
    "quality_grades": {"Utility bill / meter reading": "A", "Landlord or supplier statement": "B", "Estimate": "C"},
    "canonical_units": {"energy": "kWh"},
    "bill_fields": {
      "period_start": "Billing period start", "period_end": "Billing period end", "quantity": "kWh consumed",
      "amount_billed": "Amount billed (BDT)", "meter_id": "Meter / account no.", "supplier_name": "Utility"
    },
    "rules": [
      {"type": "unit_dimension_in", "dimensions": ["energy"],
       "problem": "Purchased electricity expects an energy quantity",
       "fix": "Enter consumption in kWh or MWh from the bill."},
      {"type": "period_order"},
      {"type": "period_within_project"}
    ]
  }
}
